<Window
    x:Class="Bookshelf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The shell: a title bar with search, the shelves on the left, pages
         in the frame, and notices (like "Removed · Undo") at the bottom. -->
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Bookshelf"
            Subtitle="Preview"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE736;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="240"
                    MaxWidth="440"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SearchBox"
                    AutomationProperties.Name="Search your shelves"
                    PlaceholderText="Search your shelves"
                    QueryIcon="Find"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchSubmitted"
                    PreviewKeyDown="OnSearchKeyDown" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="260"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnNavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ReadingItem" Content="Reading" Tag="Reading"
                                    AutomationProperties.AutomationId="ReadingShelf">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE736;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ReadingBadge" Visibility="Collapsed"
                                   Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FinishedItem" Content="Finished" Tag="Finished"
                                    AutomationProperties.AutomationId="FinishedShelf">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE930;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="FinishedBadge" Visibility="Collapsed"
                                   Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="EventuallyItem" Content="Eventually" Tag="Eventually"
                                    AutomationProperties.AutomationId="EventuallyShelf">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="EventuallyBadge" Visibility="Collapsed"
                                   Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ProfileItem" SelectsOnInvoked="False"
                                    AutomationProperties.AutomationId="ProfileButton">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="-6,0,0,0">
                        <PersonPicture x:Name="ProfilePicture" Width="28" Height="28" />
                        <TextBlock x:Name="ProfileName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout x:Name="ProfileMenu" Placement="RightEdgeAlignedBottom" />
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" Navigated="OnNavigated" NavigationFailed="OnNavigationFailed" />
                <!-- Floats over the page, so it gets a solid background of its own. -->
                <Border
                    x:Name="NoticeHost"
                    MaxWidth="640"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Translation="0,0,24"
                    Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <InfoBar
                        x:Name="Notice"
                        AutomationProperties.AutomationId="Notice"
                        IsOpen="False"
                        IsClosable="True"
                        Closed="OnNoticeClosed" />
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
