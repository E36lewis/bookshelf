<ContentDialog
    x:Class="Bookshelf.Dialogs.AddBookDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Bookshelf.Dialogs"
    Title="Add a book"
    CloseButtonText="Cancel"
    DefaultButton="None"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <!-- A result: its cover (or a stand-in with its initial), title,
             subtitle, author and year. -->
        <DataTemplate x:Key="ResultTemplate" x:DataType="dialogs:ResultItem">
            <Grid Padding="0,6,0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Decoration: the row's name says which book it is. -->
                <Border
                    Width="40"
                    Height="60"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <Grid>
                        <Grid Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}">
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.8" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{x:Bind HeadingFont}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Initial}" />
                        </Grid>
                        <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource CaptionSecondaryStyle}"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind SubtitleVisibility}" />
                    <TextBlock
                        Style="{StaticResource CaptionSecondaryStyle}"
                        Text="{x:Bind Byline}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind BylineVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid Width="560" Height="420" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <AutoSuggestBox
            x:Name="Query"
            AutomationProperties.AutomationId="BookSearch"
            AutomationProperties.Name="Search by title, author or ISBN"
            PlaceholderText="Search by title, author or ISBN"
            QueryIcon="Find"
            PreviewKeyDown="OnQueryKeyDown"
            QuerySubmitted="OnQuerySubmitted"
            TextChanged="OnQueryChanged" />

        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="Busy" AutomationProperties.Name="Searching" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="Problem" IsOpen="False" Severity="Error" />
        </StackPanel>

        <ListView
            x:Name="Results"
            Grid.Row="2"
            AutomationProperties.AutomationId="SearchResults"
            AutomationProperties.Name="Books found"
            IsItemClickEnabled="True"
            ItemClick="OnResultClick"
            ItemTemplate="{StaticResource ResultTemplate}"
            SelectionMode="None"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="Hint"
            Grid.Row="2"
            MaxWidth="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <FontIcon
                x:Name="HintGlyph"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                x:Name="HintTitle"
                HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Find a book" />
            <TextBlock
                x:Name="HintText"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Results come from Open Library."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
