<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 app: unpackaged and self-contained (no runtime to install). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 version 1809 and later. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Bookshelf</RootNamespace>
    <AssemblyName>Bookshelf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Builds the app's resource index (Bookshelf.pri), which holds the
         compiled XAML. Without it an unpackaged app can't load its windows. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Publish one Bookshelf.exe that works wherever it's put. A folder
         build only runs next to its ~520 other files: moved on its own, the
         exe can't find Bookshelf.dll and exits without any message. The
         single exe unpacks everything to %TEMP%\.net\Bookshelf on its first
         start (slower once, then quick). Supported for unpackaged,
         self-contained WinUI apps; the installer can go back to a folder. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Don't mark Bookshelf.exe as CET-compatible (.NET 9+ does by
         default). On Windows 10 PCs with a recent CPU but without Windows
         updates from 2023 on, .NET otherwise stops at startup with
         "Your Windows doesn't fully support CET" (0x80131506), before any
         of our code runs. Microsoft's documented opt-out:
         https://learn.microsoft.com/dotnet/core/compatibility/interop/9.0/cet-support -->
    <CETCompat>false</CETCompat>
    <!-- Our own Main (Program.cs) logs each startup step to startup.log. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bookshelf.Core\Bookshelf.Core.csproj" />
  </ItemGroup>
  <!-- The bundled fonts (SIL OFL), with their licenses, from packaging/fonts
       so there's one copy in the repo. Unpacked next to Bookshelf.dll and
       loaded from there (see Look.cs). -->
  <ItemGroup>
    <Content Include="..\..\packaging\fonts\ia-writer-duo\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\fonts\source-serif-4\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\fonts\ia-writer-duo\LICENSE.md" Link="Assets\Fonts\iA-Writer-Duo-LICENSE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\fonts\source-serif-4\LICENSE.md" Link="Assets\Fonts\Source-Serif-4-LICENSE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The Rust core, from `cargo build -release -p bookshelf-ffi`. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\target\release\bookshelf_ffi.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\target\release\bookshelf_ffi.dll"
          Link="bookshelf_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
