<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 app: unpackaged and self-contained (no runtime to install). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 version 1809 and later. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Bookshelf</RootNamespace>
    <AssemblyName>Bookshelf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Bookshelf.exe's icon in Explorer, the Start menu and on shortcuts
         (windows/scripts/make-icon.sh makes it). -->
    <ApplicationIcon>Assets\Bookshelf.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Builds the app's resource index (Bookshelf.pri), which holds the
         compiled XAML. Without it an unpackaged app can't load its windows. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Publish one Bookshelf.exe that works wherever it's put. A folder
         build only runs next to its ~520 other files: moved on its own, the
         exe can't find Bookshelf.dll and exits without any message. The
         single exe unpacks everything to %TEMP%\.net\Bookshelf on its first
         start (slower once, then quick). Supported for unpackaged,
         self-contained WinUI apps. The installer installs a folder build
         instead (windows/installer/build-installer.ps1): nothing to unpack. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Bookshelf.exe stays CET-compatible, as .NET 9+ marks it: on PCs
         whose processor has CET (most from 2021 on), Windows then guards
         its return addresses with a shadow stack. Such a PC also needs a
         Windows update that .NET relies on, or .NET stops at startup with
         "Your Windows doesn't fully support CET" (0x80131506) before any
         of our code runs; the installer checks for it (CetSupportMissing in
         windows/installer/Bookshelf.iss, which says which updates). -->
    <!-- The version everywhere: the exe's details, Settings › About and the
         installer (release.yml checks it against Cargo.toml and project.yml). -->
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <Copyright>Copyright © 2026 e36lewis. Free software under the GPL 3.0 or later.</Copyright>
    <!-- Which journal the app opens. Only release builds say Stable
         (dotnet publish -p:BookshelfChannel=Stable): those are "Bookshelf"
         and open the real journal. Every other build is "Bookshelf Preview"
         with a journal of its own, so dev and CI builds can't touch real
         books. See AppFolders.cs. -->
    <BookshelfChannel Condition="'$(BookshelfChannel)' == ''">Preview</BookshelfChannel>
    <DefineConstants Condition="'$(BookshelfChannel)' == 'Stable'">$(DefineConstants);BOOKSHELF_STABLE</DefineConstants>
    <AssemblyTitle Condition="'$(BookshelfChannel)' == 'Stable'">Bookshelf</AssemblyTitle>
    <AssemblyTitle Condition="'$(BookshelfChannel)' != 'Stable'">Bookshelf Preview</AssemblyTitle>
    <Product>$(AssemblyTitle)</Product>
    <!-- Our own Main (Program.cs) logs each startup step to startup.log. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Target Name="CheckBookshelfChannel" BeforeTargets="CoreCompile">
    <Error Condition="'$(BookshelfChannel)' != 'Stable' and '$(BookshelfChannel)' != 'Preview'"
           Text="BookshelfChannel must be Stable or Preview, not '$(BookshelfChannel)'." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bookshelf.Core\Bookshelf.Core.csproj" />
  </ItemGroup>
  <!-- The bundled fonts (SIL OFL), with their licenses, from packaging/fonts
       so there's one copy in the repo. Unpacked next to Bookshelf.dll and
       loaded from there (see Look.cs). -->
  <ItemGroup>
    <Content Include="..\..\packaging\fonts\ia-writer-duo\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\fonts\source-serif-4\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\fonts\ia-writer-duo\LICENSE.md" Link="Assets\Fonts\iA-Writer-Duo-LICENSE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\fonts\source-serif-4\LICENSE.md" Link="Assets\Fonts\Source-Serif-4-LICENSE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The icon again as a file, unpacked next to Bookshelf.dll, for the
       window (taskbar, Alt+Tab) and its title bar: see MainWindow.SetIconsAsync. -->
  <ItemGroup>
    <Content Include="Assets\Bookshelf.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The Rust core, from `cargo build -release -p bookshelf-ffi`. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\target\release\bookshelf_ffi.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\target\release\bookshelf_ffi.dll"
          Link="bookshelf_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
