<pages:BookshelfPage
    x:Class="Bookshelf.Pages.BookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Bookshelf.Pages">

    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="BookPage">
        <StackPanel
            MaxWidth="860"
            Padding="40,28,40,48"
            HorizontalAlignment="Stretch"
            Spacing="8">

            <InfoBar
                x:Name="Problem"
                Margin="0,0,0,12"
                IsOpen="False"
                Severity="Error" />

            <!-- The book: cover, title, author, details, and what to do. -->
            <Grid ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Decoration: the title is right beside it. -->
                <Border
                    x:Name="CoverFrame"
                    Width="128"
                    Height="192"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid x:Name="CoverStandIn">
                            <Rectangle Width="7" HorizontalAlignment="Left" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.8" />
                            <TextBlock
                                x:Name="CoverInitial"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="52"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="4">
                    <TextBlock
                        x:Name="BookTitle"
                        AutomationProperties.AutomationId="BookTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource PageTitleStyle}" />
                    <TextBlock
                        x:Name="Subtitle"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        FontWeight="Normal"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="Author"
                        Margin="0,4,0,0"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="Details"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionSecondaryStyle}" />

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="WriteButton"
                            AutomationProperties.AutomationId="WriteButton"
                            Click="OnWrite"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                <TextBlock x:Name="WriteLabel" Text="Write" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ReadButton"
                            AutomationProperties.AutomationId="ReadButton"
                            Click="OnRead">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE736;" />
                                <TextBlock Text="Read" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MoreButton"
                            AutomationProperties.AutomationId="MoreButton"
                            AutomationProperties.Name="More options"
                            ToolTipService.ToolTip="More options">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Click="OnReadAgain" Text="Read it again">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="RemoveItem"
                                        Click="OnRemove"
                                        KeyboardAcceleratorTextOverride="Del"
                                        Text="Remove from my shelf">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Expander
                x:Name="About"
                Margin="0,24,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Header="About this book">
                <TextBlock
                    x:Name="Description"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Expander>

            <!-- When it was read. Saved the moment a date is picked. -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SectionTitleStyle}"
                Text="Reading dates" />
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,16">
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Started" />
                    <CalendarDatePicker
                        x:Name="StartedPicker"
                        Grid.Column="1"
                        MinWidth="180"
                        AutomationProperties.Name="Started"
                        DateChanged="OnStartedChanged"
                        PlaceholderText="Not started" />
                    <Button Grid.Column="2" Click="OnStartedToday" Content="Today" x:Name="StartedToday"
                            AutomationProperties.Name="Started today" />
                    <Button Grid.Column="3" Click="OnStartedClear" x:Name="StartedClear"
                            AutomationProperties.Name="Clear the start date" ToolTipService.ToolTip="Clear date">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Finished" />
                    <CalendarDatePicker
                        x:Name="FinishedPicker"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="180"
                        AutomationProperties.Name="Finished"
                        DateChanged="OnFinishedChanged"
                        PlaceholderText="Not finished" />
                    <Button Grid.Row="1" Grid.Column="2" Click="OnFinishedToday" Content="Today" x:Name="FinishedToday"
                            AutomationProperties.Name="Finished today" />
                    <Button Grid.Row="1" Grid.Column="3" Click="OnFinishedClear" x:Name="FinishedClear"
                            AutomationProperties.Name="Clear the finish date" ToolTipService.ToolTip="Clear date">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>

                    <TextBlock
                        x:Name="DaysText"
                        Grid.Row="2"
                        Grid.ColumnSpan="5"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CaptionSecondaryStyle}" />
                </Grid>
            </Border>

            <!-- What was written, laid out like a page. Clicking it opens the writer. -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SectionTitleStyle}"
                Text="My summary" />
            <Border
                x:Name="SummaryCard"
                Padding="32,28,32,32"
                AutomationProperties.Name="My summary. Select to write."
                Style="{StaticResource CardStyle}"
                Tapped="OnSummaryTapped">
                <Grid>
                    <RichTextBlock x:Name="Preview" AutomationProperties.AutomationId="SummaryPreview" />
                    <TextBlock
                        x:Name="NothingYet"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Nothing written yet. Select Write to begin."
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</pages:BookshelfPage>
