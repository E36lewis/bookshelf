<pages:BookshelfPage
    x:Class="Bookshelf.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bookshelf.Controls"
    xmlns:pages="using:Bookshelf.Pages"
    Foreground="{ThemeResource JournalInkBrush}">

    <pages:BookshelfPage.Resources>
        <ResourceDictionary>
            <!-- Text fields' edges: medium ink, ink when focused (kept to the
                 fields here, away from the writing page's editor). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#858A91" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#17233C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#92969C" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#F0F2F4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </pages:BookshelfPage.Resources>

    <!-- Every change is saved and applied right away, for this profile. Each
         group is a heading and a panel of rows, as in the GTK app; the last
         row of a panel has no rule under it. -->
    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="SettingsScroller">
        <StackPanel
            MaxWidth="{StaticResource ReadableWidth}"
            Padding="16,20,16,48"
            HorizontalAlignment="Stretch">
            <TextBlock
                Margin="2,0,0,4"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource PageTitleStyle}"
                Text="Settings" />
            <InfoBar x:Name="Problem" IsOpen="False" Severity="Error" />

            <!-- Profile -->
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Profile" />
            <Border Padding="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <controls:SettingsCard Header="Name">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="NameBox"
                                Width="220"
                                AutomationProperties.Name="Name"
                                KeyDown="OnNameKeyDown"
                                Style="{StaticResource FieldTextBoxStyle}"
                                TextChanged="OnNameChanged" />
                            <Button
                                x:Name="SaveName"
                                AutomationProperties.Name="Save name"
                                Click="OnSaveName"
                                Content="Save"
                                IsEnabled="False"
                                Style="{StaticResource PillButtonStyle}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="EmailCard"
                        BorderThickness="0"
                        Description="Sent only to Open Library, with your book searches and cover downloads."
                        Header="Email (optional)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="EmailBox"
                                Width="220"
                                AutomationProperties.Name="Email (optional)"
                                InputScope="EmailSmtpAddress"
                                KeyDown="OnEmailKeyDown"
                                PlaceholderText="you@example.com"
                                Style="{StaticResource FieldTextBoxStyle}"
                                TextChanged="OnEmailChanged" />
                            <Button
                                x:Name="SaveEmail"
                                AutomationProperties.Name="Save email"
                                Click="OnSaveEmail"
                                Content="Save"
                                IsEnabled="False"
                                Style="{StaticResource PillButtonStyle}" />
                            <Button
                                x:Name="EmailInfo"
                                AutomationProperties.Name="Why an email?"
                                Style="{StaticResource BackButtonStyle}"
                                ToolTipService.ToolTip="Why an email?">
                                <FontIcon FontSize="16" Glyph="&#xE946;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <TextBlock
                                            x:Name="EmailWhy"
                                            MaxWidth="320"
                                            TextWrapping="Wrap" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>
            </Border>
            <TextBlock
                x:Name="ProfileError"
                Margin="4,8,0,0"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{ThemeResource JournalErrorBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- Appearance -->
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Appearance" />
            <Border Padding="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <controls:SettingsCard Header="Theme">
                        <ComboBox
                            x:Name="ThemeBox"
                            MinWidth="200"
                            AutomationProperties.Name="Theme"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="Match Windows" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="Buttons, links and highlights" Header="Accent color">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="2" />
                            <Button
                                x:Name="CustomAccent"
                                AutomationProperties.Name="Custom color"
                                Style="{StaticResource BackButtonStyle}"
                                ToolTipService.ToolTip="Custom color">
                                <FontIcon FontSize="16" Glyph="&#xE790;" />
                                <Button.Flyout>
                                    <Flyout x:Name="CustomFlyout">
                                        <StackPanel Spacing="12">
                                            <ColorPicker
                                                x:Name="AccentPicker"
                                                IsAlphaEnabled="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsHexInputVisible="True"
                                                IsMoreButtonVisible="False" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Click="OnUseCustomAccent"
                                                Content="Use this color"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard BorderThickness="0" Description="Serif is bookish, sans-serif is clean" Header="Titles and summaries">
                        <ComboBox
                            x:Name="HeadingFontBox"
                            MinWidth="200"
                            AutomationProperties.Name="Titles and summaries"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnHeadingFontChanged">
                            <ComboBoxItem Content="Serif" />
                            <ComboBoxItem Content="Sans-serif" />
                        </ComboBox>
                    </controls:SettingsCard>
                </StackPanel>
            </Border>

            <!-- Writing -->
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Writing" />
            <Border Padding="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <controls:SettingsCard Header="Font">
                        <ComboBox
                            x:Name="WritingFontBox"
                            MinWidth="240"
                            AutomationProperties.Name="Writing font"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnWritingFontChanged">
                            <ComboBoxItem Content="iA Writer Duo (monospace)" />
                            <ComboBoxItem Content="Source Serif" />
                            <ComboBoxItem Content="System sans-serif" />
                            <ComboBoxItem Content="System monospace" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="Points" Header="Text size">
                        <NumberBox
                            x:Name="SizeBox"
                            MinWidth="120"
                            AutomationProperties.Name="Text size in points"
                            CornerRadius="8"
                            LargeChange="2"
                            Maximum="28"
                            Minimum="10"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="OnSizeChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Line spacing">
                        <ComboBox
                            x:Name="SpacingBox"
                            MinWidth="200"
                            AutomationProperties.Name="Line spacing"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnSpacingChanged">
                            <ComboBoxItem Content="Tight" />
                            <ComboBoxItem Content="Comfortable" />
                            <ComboBoxItem Content="Airy" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Page width">
                        <ComboBox
                            x:Name="WidthBox"
                            MinWidth="200"
                            AutomationProperties.Name="Page width"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnWidthChanged">
                            <ComboBoxItem Content="Narrow" />
                            <ComboBoxItem Content="Medium" />
                            <ComboBoxItem Content="Wide" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard BorderThickness="0" Description="Dim everything except the sentence you're writing" Header="Start in focus mode">
                        <ToggleSwitch
                            x:Name="FocusSwitch"
                            MinWidth="0"
                            AutomationProperties.Name="Start in focus mode"
                            OffContent=""
                            OnContent=""
                            Toggled="OnFocusToggled" />
                    </controls:SettingsCard>
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="24,20,24,20" Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="Preview" />
                    <TextBlock
                        x:Name="WritingPreview"
                        Text="The quiet hours between chapters are where the best thoughts arrive."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Reading log -->
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Reading log" />
            <Border Padding="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <controls:SettingsCard Header="Date format">
                        <ComboBox
                            x:Name="DateFormatBox"
                            MinWidth="200"
                            AutomationProperties.Name="Date format"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnDateFormatChanged">
                            <ComboBoxItem Content="Sep 20, 2026" />
                            <ComboBoxItem Content="09/20/2026" />
                            <ComboBoxItem Content="20/09/2026" />
                            <ComboBoxItem Content="2026-09-20" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="For the calendar" Header="Week starts on">
                        <ComboBox
                            x:Name="WeekBox"
                            MinWidth="200"
                            AutomationProperties.Name="Week starts on"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnWeekChanged">
                            <ComboBoxItem Content="Sunday" />
                            <ComboBoxItem Content="Monday" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard BorderThickness="0" Description="The shelf you see first" Header="Open to">
                        <ComboBox
                            x:Name="StartShelfBox"
                            MinWidth="200"
                            AutomationProperties.Name="Open to"
                            CornerRadius="16"
                            FontWeight="SemiBold"
                            SelectionChanged="OnStartShelfChanged">
                            <ComboBoxItem Content="Reading" />
                            <ComboBoxItem Content="Finished" />
                            <ComboBoxItem Content="Eventually" />
                        </ComboBox>
                    </controls:SettingsCard>
                </StackPanel>
            </Border>

            <!-- Your data -->
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Your data" />
            <Border Padding="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <controls:SettingsCard
                        Description="Each summary becomes a Markdown file, in a “Bookshelf summaries” folder inside the folder you choose"
                        Header="Export my summaries">
                        <Button
                            x:Name="ExportButton"
                            Click="OnExport"
                            Content="Export…"
                            Style="{StaticResource PillButtonStyle}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="BackupsCard"
                        BorderThickness="0"
                        Description="Checking…"
                        Header="Daily backups">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ResetBackups"
                                AutomationProperties.Name="Use the default folder again"
                                Click="OnResetBackups"
                                Content="Use default"
                                Style="{StaticResource PillButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="OpenBackups"
                                AutomationProperties.Name="Open the backup folder"
                                Click="OnOpenBackups"
                                Content="Open folder"
                                Style="{StaticResource PillButtonStyle}" />
                            <Button
                                x:Name="ChangeBackups"
                                Click="OnChangeBackups"
                                Content="Change…"
                                Style="{StaticResource PillButtonStyle}"
                                ToolTipService.ToolTip="Keep backups somewhere else, like a USB drive or a synced folder, so they survive if this computer's disk fails" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>
            </Border>

            <!-- Help -->
            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Help" />
            <Border Padding="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <controls:SettingsCard Description="Every key, on one page" Header="Keyboard shortcuts">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="ShortcutsKey" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" />
                            <Button
                                x:Name="ShortcutsButton"
                                AutomationProperties.Name="Show the keyboard shortcuts"
                                Click="OnShortcuts"
                                Content="Show"
                                Style="{StaticResource PillButtonStyle}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="How everything works" Header="User manual">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="ManualKey" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" />
                            <Button
                                x:Name="ManualButton"
                                AutomationProperties.Name="Open the user manual"
                                Click="OnManual"
                                Content="Open"
                                Style="{StaticResource PillButtonStyle}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="AboutCard" BorderThickness="0" Header="Bookshelf">
                        <Button Click="OnOpenDataFolder" Content="Open data folder" Style="{StaticResource PillButtonStyle}" />
                    </controls:SettingsCard>
                </StackPanel>
            </Border>

            <!-- Danger zone -->
            <Button
                x:Name="DeleteButton"
                Margin="0,32,0,0"
                AutomationProperties.AutomationId="DeleteProfileButton"
                AutomationProperties.Name="Delete this profile…"
                Click="OnDeleteProfile"
                Style="{StaticResource DestructiveButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock Text="Delete this profile…" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</pages:BookshelfPage>
