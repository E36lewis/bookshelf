<pages:BookshelfPage
    x:Class="Bookshelf.Pages.ProblemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Bookshelf.Pages">

    <!-- Shown instead of the app when the journal can't be opened, so the
         window explains itself rather than closing. -->
    <StackPanel
        MaxWidth="520"
        Margin="32"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <FontIcon
            HorizontalAlignment="Left"
            FontSize="40"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Glyph="&#xE783;" />
        <TextBlock
            AutomationProperties.AutomationId="ProblemTitle"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource PageTitleStyle}"
            Text="Bookshelf couldn't start" />
        <TextBlock
            x:Name="Message"
            AutomationProperties.AutomationId="ProblemMessage"
            IsTextSelectionEnabled="True"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />
    </StackPanel>
</pages:BookshelfPage>
