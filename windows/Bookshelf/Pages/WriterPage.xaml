<pages:BookshelfPage
    x:Class="Bookshelf.Pages.WriterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Bookshelf.Pages">

    <!-- The writing page, simple for now: one column of text that saves as
         you type. The formatting bar and focus mode come in Phase 4. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="Column"
            Padding="32,40,32,0"
            HorizontalAlignment="Stretch">
            <RichEditBox
                x:Name="Editor"
                Padding="0,0,0,240"
                AutomationProperties.AutomationId="Editor"
                AutomationProperties.Name="Your summary"
                BorderThickness="0"
                DisabledFormattingAccelerators="All"
                IsSpellCheckEnabled="False"
                TextWrapping="Wrap">
                <RichEditBox.Resources>
                    <!-- A page, not a form field: no box around the text. -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </RichEditBox.Resources>
            </RichEditBox>
            <!-- Questions on an empty page, gone as soon as you type. -->
            <TextBlock
                x:Name="Prompt"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                IsHitTestVisible="False"
                TextWrapping="Wrap" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="24,6,12,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="WriterTitle"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionSecondaryStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="Status"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="WriterStatus"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource CaptionSecondaryStyle}" />
            <TextBlock
                x:Name="Problem"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                Click="OnSave"
                Content="Save"
                Style="{StaticResource SubtleButtonStyle}" />
            <Button
                x:Name="FullScreenButton"
                Grid.Column="3"
                AutomationProperties.Name="Full screen"
                Click="OnFullScreen"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon x:Name="FullScreenIcon" FontSize="14" Glyph="&#xE740;" />
            </Button>
        </Grid>
    </Grid>
</pages:BookshelfPage>
