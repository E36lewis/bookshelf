<pages:BookshelfPage
    x:Class="Bookshelf.Pages.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bookshelf.Controls"
    xmlns:pages="using:Bookshelf.Pages"
    Foreground="{ThemeResource JournalInkBrush}"
    NavigationCacheMode="Required">

    <pages:BookshelfPage.Resources>
        <ThemeShadow x:Key="CoverShadow" />
        <controls:CardHeights x:Key="Heights" />

        <!-- A book: its cover (or a stand-in with its initial), title,
             author, dates and the start of what was written, centered on a
             card. The whole card is one button, named for Narrator; what's
             on it is decoration. -->
        <DataTemplate x:Key="CardTemplate" x:DataType="pages:EntryItem">
            <Button
                AutomationProperties.AutomationId="BookCard"
                AutomationProperties.Name="{x:Bind AutomationName}"
                AutomationProperties.PositionInSet="{x:Bind Position}"
                AutomationProperties.SizeOfSet="{x:Bind SetSize}"
                Click="OnCardClick"
                Style="{StaticResource BookCardStyle}"
                Tag="{x:Bind SummaryId}">
                <StackPanel AutomationProperties.AccessibilityView="Raw" Spacing="2">
                    <Border
                        Width="104"
                        Height="156"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource JournalCoverStandInBrush}"
                        BorderBrush="{ThemeResource JournalRuleBrush}"
                        BorderThickness="1"
                        CornerRadius="4,6,6,4"
                        Shadow="{StaticResource CoverShadow}"
                        Translation="0,0,8">
                        <Grid>
                            <Grid Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}">
                                <Rectangle Width="6" HorizontalAlignment="Left" Fill="{ThemeResource JournalAccentFillBrush}" Opacity="0.8" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{x:Bind HeadingFont}"
                                    FontSize="42"
                                    Foreground="{ThemeResource JournalMutedBrush}"
                                    Text="{x:Bind Initial}" />
                            </Grid>
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock
                        FontFamily="{x:Bind HeadingFont}"
                        FontSize="16"
                        FontWeight="Bold"
                        LineHeight="20"
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource JournalMutedBrush}"
                        MaxLines="1"
                        Text="{x:Bind Author}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind AuthorVisibility}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        CharacterSpacing="30"
                        FontSize="10.7"
                        FontWeight="Bold"
                        Foreground="{ThemeResource JournalAccentTextBrush}"
                        MaxLines="1"
                        Text="{x:Bind MetaCaps}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind MetaVisibility}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontFamily="{x:Bind HeadingFont}"
                        FontSize="13.2"
                        Foreground="{ThemeResource JournalExcerptBrush}"
                        LineHeight="14.5"
                        LineStackingStrategy="BlockLineHeight"
                        MaxLines="3"
                        Text="{x:Bind Excerpt}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ExcerptVisibility}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13.2"
                        FontStyle="Italic"
                        Foreground="{ThemeResource JournalMutedBrush}"
                        MaxLines="1"
                        Text="{x:Bind EmptyNote}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind EmptyNoteVisibility}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CardRowTemplate" x:DataType="pages:CardRow">
            <ItemsRepeater ItemTemplate="{StaticResource CardTemplate}" ItemsSource="{x:Bind Cards}">
                <ItemsRepeater.Layout>
                    <controls:CardRowLayout Heights="{StaticResource Heights}" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </DataTemplate>

        <!-- "2026 · 12 books" above the Finished shelf's books of each year. -->
        <DataTemplate x:Key="YearTemplate" x:DataType="pages:YearRow">
            <StackPanel Margin="2,6,0,-4" Orientation="Horizontal" Spacing="10">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    FontFamily="{x:Bind HeadingFont}"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="{x:Bind YearText}" />
                <TextBlock
                    Margin="0,0,0,2"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind Label}" />
            </StackPanel>
        </DataTemplate>

        <pages:ShelfRowTemplates x:Key="RowTemplates" Cards="{StaticResource CardRowTemplate}" Year="{StaticResource YearTemplate}" />
    </pages:BookshelfPage.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller">
            <StackPanel
                MaxWidth="{StaticResource ReadableWidth}"
                Padding="{StaticResource PagePadding}"
                HorizontalAlignment="Stretch">
                <StackPanel Margin="2,0,0,18" Spacing="2">
                    <TextBlock
                        x:Name="Heading"
                        AutomationProperties.AutomationId="ShelfHeading"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource PageTitleStyle}" />
                    <TextBlock
                        x:Name="CountLine"
                        AutomationProperties.AutomationId="ShelfCount"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <!-- The books, by year on Finished: each row of cards is laid
                     out by CardRowLayout. Tab reaches the grid once; the arrow
                     keys move from card to card. -->
                <ItemsRepeater
                    x:Name="Entries"
                    AutomationProperties.AutomationId="ShelfList"
                    AutomationProperties.Name="Books on this shelf"
                    ItemTemplate="{StaticResource RowTemplates}"
                    SizeChanged="OnEntriesSizeChanged"
                    TabFocusNavigation="Once"
                    XYFocusKeyboardNavigation="Enabled">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            MaxWidth="380"
            Margin="24,0,24,96"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <FontIcon
                x:Name="EmptyGlyph"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="44"
                Foreground="{ThemeResource JournalMutedBrush}"
                Glyph="&#xE8F1;" />
            <TextBlock
                x:Name="EmptyTitle"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                AutomationProperties.LiveSetting="Polite"
                FontFamily="{ThemeResource JournalHeadingFont}"
                FontSize="22"
                FontWeight="Bold"
                TextAlignment="Center" />
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="EmptyAddButton"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="EmptyAddBookButton"
                AutomationProperties.Name="Add a book"
                Click="OnAddBook"
                Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add a book" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</pages:BookshelfPage>
