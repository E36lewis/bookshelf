<pages:BookshelfPage
    x:Class="Bookshelf.Pages.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Bookshelf.Pages"
    NavigationCacheMode="Required">

    <pages:BookshelfPage.Resources>
        <!-- A book: cover (or a stand-in with its initial), title, author,
             dates and the start of what was written. -->
        <DataTemplate x:Key="EntryTemplate" x:DataType="pages:EntryItem">
            <Grid Padding="0,12,0,12" ColumnSpacing="18" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="64"
                    Height="96"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}">
                            <Rectangle Width="5" HorizontalAlignment="Left" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.8" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{x:Bind HeadingFont}"
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Initial}" />
                        </Grid>
                        <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontFamily="{x:Bind HeadingFont}"
                        MaxLines="2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        FontSize="19"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Author}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind AuthorVisibility}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind MetaVisibility}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="{x:Bind HeadingFont}"
                        MaxLines="3"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Excerpt}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ExcerptVisibility}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind EmptyNote}"
                        Visibility="{x:Bind EmptyNoteVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="YearTemplate" x:DataType="pages:YearGroup">
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    FontFamily="{x:Bind HeadingFont}"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind YearText}" />
                <TextBlock
                    Margin="0,0,0,3"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource CaptionSecondaryStyle}"
                    Text="{x:Bind Label}" />
            </StackPanel>
        </DataTemplate>
    </pages:BookshelfPage.Resources>

    <Grid MaxWidth="940" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="40,28,40,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="Heading"
                    AutomationProperties.AutomationId="ShelfHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Name="CountLine"
                    AutomationProperties.AutomationId="ShelfCount"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button
                x:Name="AddButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="AddBookButton"
                AutomationProperties.Name="Add a book"
                Click="OnAddBook"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Add a book" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView
            x:Name="Entries"
            Grid.Row="1"
            Padding="28,0,28,32"
            AutomationProperties.AutomationId="ShelfList"
            AutomationProperties.Name="Books on this shelf"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemTemplate="{StaticResource EntryTemplate}"
            SelectionMode="None">
            <ListView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource YearTemplate}" HidesIfEmpty="True" />
            </ListView.GroupStyle>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            MaxWidth="380"
            Margin="24,0,24,96"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <FontIcon
                x:Name="EmptyGlyph"
                FontSize="44"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8F1;" />
            <TextBlock
                x:Name="EmptyTitle"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center" />
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="EmptyAddButton"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Click="OnAddBook"
                Content="Add a book"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</pages:BookshelfPage>
